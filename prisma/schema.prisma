generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Ejemplo de tabla consumible por la API (`/api/v1/vehicles`).
/// Puedes renombrar o ampliar modelos y luego ejecutar `npm run db:migrate`.
model Vehicle {
  id        String   @id
  name      String
  brand     String?
  price     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CatalogVehicleType {
  CARRO
  CAMIONETA
}

/// Ajustes globales de la landing (cantidad de vehículos visibles, etc.).
model LandingSettings {
  id                 String   @id @default("default")
  maxVisibleVehicles Int      @default(10)
  content            Json?
  updatedAt          DateTime @updatedAt
}

/// Historial de cambios en el panel admin de la landing.
model LandingAuditLog {
  id         String   @id
  actorEmail String
  action     String
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([actorEmail])
}

/// Vehículos del catálogo mostrados en la landing.
model CatalogVehicle {
  id             String               @id
  slug           String               @unique
  name           String
  subtitle       String
  type           CatalogVehicleType
  highlights     Json
  features       Json
  specs          Json
  badge          String?
  popular        Boolean              @default(false)
  weeklyPriceCop Int
  active         Boolean              @default(true)
  sortOrder      Int                  @default(0)
  specSheetPath  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  images         CatalogVehicleImage[]
}

/// Imágenes del catálogo: archivo en disco (`storedPath`) o URL estática legacy (`publicUrl`).
model CatalogVehicleImage {
  id           String         @id
  vehicleId    String
  vehicle      CatalogVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  storedPath   String?
  publicUrl    String?
  originalName String
  mimeType     String
  sizeBytes    Int            @default(0)
  sortOrder    Int            @default(0)
  isPrimary    Boolean        @default(false)
  createdAt    DateTime       @default(now())

  @@index([vehicleId])
}

enum UserType {
  USER
  ADVISOR
  ADMIN
  ANALYST
  WORKSHOP
}

enum DocumentValidationStatus {
  PENDING
  VALIDATED
  REJECTED
}

/// Usuarios registrados. Contraseña (bcrypt) o Google (`googleId`); al menos uno debe existir.
model User {
  id                    String                     @id
  email                 String                     @unique
  passwordHash          String?
  googleId              String?                    @unique
  userType              UserType
  /// Teléfono de contacto editable por el usuario.
  phone                 String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  documents             Document[]
  identityExtraction    UserIdentityExtraction?
  workAddressExtraction UserWorkAddressExtraction?
  vehiclePlan           ClientVehiclePlan?
  inspectionAppointments InspectionAppointment[] @relation("ClientInspectionAppointments")
  managedWorkshop       Workshop?
  notifications         UserNotification[]
  inspectionSurveys     InspectionSurvey[]
  pushSubscriptions     PushSubscription[]
  application           Application?
  vehicleDeliveries     VehicleDelivery[] @relation("ClientDeliveries")
  advisorDeliveries     VehicleDelivery[] @relation("AdvisorDeliveries")
}

enum ApplicationStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

/// Solicitud del cliente tras completar documentos en /solicitud.
model Application {
  id                 String            @id
  userId             String            @unique
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             ApplicationStatus @default(SUBMITTED)
  submittedAt        DateTime          @default(now())
  reviewedAt         DateTime?
  reviewedByUserId   String?
  rejectionReason    String?
  vehicleDelivery    VehicleDelivery?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status, submittedAt(sort: Desc)])
}

enum DeliveryStatus {
  PENDING_DOCUMENTS
  DOCUMENTS_SENT
  DOCUMENTS_SIGNED
  IN_DELIVERY
  AWAITING_CLIENT_CONFIRMATION
  COMPLETED
}

/// Proceso de entrega física del vehículo (desde solicitud aprobada o alta manual del analista).
model VehicleDelivery {
  id                 String         @id
  userId             String?
  user               User?          @relation("ClientDeliveries", fields: [userId], references: [id], onDelete: SetNull)
  applicationId      String?        @unique
  application        Application?   @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  advisorUserId      String?
  advisor            User?          @relation("AdvisorDeliveries", fields: [advisorUserId], references: [id], onDelete: SetNull)

  clientName         String
  idDocumentNumber   String
  address            String?
  email              String
  phone              String?
  deliveryLocation   String?

  status             DeliveryStatus @default(PENDING_DOCUMENTS)

  contractSentAt         DateTime?
  contractSignedAt       DateTime?
  insuranceSentAt        DateTime?
  insuranceSignedAt      DateTime?
  promissoryNoteSentAt   DateTime?
  promissoryNoteSignedAt DateTime?

  vin                    String?
  taxPayment             String?
  soatPayment            String?
  platesChassisDecl      String?
  engineNumber           String?
  serialNumber           String?
  axles                  String?
  pbvKg                  String?
  color                  String?
  fuelType               String?
  vehicleClass           String?
  brand                  String?
  line                   String?
  model                  String?
  bodyType               String?
  passengerCapacity      String?
  displacement           String?

  accessoryChecklist     Json?

  completedByAdvisorAt   DateTime?
  clientConfirmedAt      DateTime?
  confirmationToken      String?        @unique

  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([advisorUserId])
}

/// Archivos o imágenes subidos por usuario (metadatos en BD; bytes en disco bajo uploads/).
model Document {
  id                 String                   @id
  userId             String
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentKind       String
  validationStatus   DocumentValidationStatus @default(PENDING)
  /// Motivo de rechazo (p. ej. verificación automática con IA).
  validationMessage  String?
  originalName       String
  mimeType           String
  sizeBytes          Int
  storedPath         String
  createdAt          DateTime                 @default(now())

  @@unique([userId, documentKind])
  @@index([userId])
}

/// Datos extraídos por IA del documento de identidad (cédula, cédula de extranjería, pasaporte, etc.) y del pase (licencia), un registro por usuario.
model UserIdentityExtraction {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Nombres de pila según el documento de identidad.
  firstName String?
  /// Apellidos según el documento de identidad.
  lastName  String?
  /// Fecha de nacimiento (YYYY-MM-DD) si se pudo leer con claridad.
  birthDate        String?
  /// Número o código del documento de identidad (p. ej. cédula, CE, pasaporte).
  idDocumentNumber String?

  /// Si el pase corresponde al mismo titular que el documento de identidad (null = aún no evaluado o datos insuficientes).
  licenseMatchesCedula Boolean?
  /// Fecha hasta la cual el pase tiene vigencia autorizada (YYYY-MM-DD cuando se pudo inferir).
  licenseValidUntil    String?

  /// Documento `Document.id` del frente de identidad validado (referencia a la foto en disco bajo `uploads/`).
  identityPhotoDocumentId String?
  /// La selfie corresponde facialmente al titular del documento de identidad.
  selfieMatchesIdentityPerson Boolean?
  /// La selfie no es la misma imagen/recorte que la foto del documento (toma distinta, p. ej. selfie real).
  selfieIsDistinctCaptureFromIdentity Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Paso 3: apps de conductor, banco y recibo de vivienda — datos validados o extraídos con IA.
model UserWorkAddressExtraction {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  utilityServiceAddress String?

  bankHolderMatchesIdentity Boolean?

  /// Ej.: {"platformWork1":{"appKey":"uber","rating":4.9}}
  platformCapturesMeta Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum InspectionAppointmentKind {
  BUSINESS_PLANNED
  CLIENT_REQUESTED
}

enum InspectionAppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  REJECTED
  COMPLETED
  CANCELLED
  RESCHEDULE_PENDING
}

enum InspectionSessionStatus {
  IN_PROGRESS
  COMPLETED
}

enum InspectionSurveyStatus {
  PENDING
  SUBMITTED
}

enum ProcedureSuggestionStatus {
  PENDING_ADMIN
  APPROVED_IMMEDIATE
  APPROVED_CLIENT_SCHEDULE
  REJECTED
}

/// Taller asociado a atoo; el usuario WORKSHOP gestiona disponibilidad y citas.
model Workshop {
  id        String   @id
  name      String
  address   String
  city      String
  phone     String?
  latitude  Float?
  longitude Float?
  active    Boolean  @default(true)
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  slots     WorkshopAvailabilitySlot[]
  appointments InspectionAppointment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Franjas de disponibilidad que el taller publica (fecha, horario y cupos).
model WorkshopAvailabilitySlot {
  id              String   @id
  workshopId      String
  workshop        Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  date            String
  startTime       String
  endTime         String
  maxAppointments Int
  bookedCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([workshopId, date, startTime])
  @@index([workshopId, date])
}

/// Plan de revisión técnico-mecánica asignado al entregar el vehículo (solo lectura para el cliente).
model ClientVehiclePlan {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleName         String
  vin                 String?
  deliveredAt         DateTime
  nextInspectionDueAt DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// Citas de revisión: planificadas por el negocio o solicitadas por el cliente.
model InspectionAppointment {
  id                String                      @id
  userId            String
  user              User                        @relation("ClientInspectionAppointments", fields: [userId], references: [id], onDelete: Cascade)
  workshopId        String
  workshop          Workshop                    @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  kind              InspectionAppointmentKind
  status            InspectionAppointmentStatus @default(PENDING)
  appointmentDate   String
  appointmentTime   String?
  proposedAppointmentDate String?
  proposedAppointmentTime String?
  rescheduleInitiatedBy   String?
  reason            String?
  proofStoredPath   String?
  proofMimeType     String?
  proofOriginalName String?
  proofSizeBytes    Int?
  workshopNotes     String?
  vehicleNameSnapshot String?
  vinSnapshot         String?
  session           InspectionSession?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@index([userId])
  @@index([workshopId, appointmentDate])
  @@index([workshopId, status])
}

/// Sesión de revisión iniciada por el taller durante la cita.
model InspectionSession {
  id            String                  @id
  appointmentId String                  @unique
  appointment   InspectionAppointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  status        InspectionSessionStatus @default(IN_PROGRESS)
  startedAt     DateTime                @default(now())
  completedAt   DateTime?
  notes         String?
  checklistItems InspectionChecklistItem[]
  suggestions   InspectionProcedureSuggestion[]
  survey        InspectionSurvey?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
}

/// Pasos estándar (y adicionales autorizados) de la revisión.
model InspectionChecklistItem {
  id          String            @id
  sessionId   String
  session     InspectionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title       String
  description String?
  sortOrder   Int               @default(0)
  completed   Boolean           @default(false)
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([sessionId])
}

/// Procedimientos adicionales sugeridos por el taller; requieren autorización del admin.
model InspectionProcedureSuggestion {
  id               String                    @id
  sessionId        String
  session          InspectionSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  estimatedCostCop Int?
  isUrgent         Boolean                   @default(false)
  status           ProcedureSuggestionStatus @default(PENDING_ADMIN)
  adminNotes       String?
  reviewedAt       DateTime?
  reviewedByUserId String?
  deadlineAt       DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([sessionId])
  @@index([status])
}

/// Encuesta del cliente al finalizar una revisión.
model InspectionSurvey {
  id          String                 @id
  sessionId   String                 @unique
  session     InspectionSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      InspectionSurveyStatus @default(PENDING)
  rating      Int?
  comment     String?
  submittedAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([userId, status])
}

/// Notificaciones in-app para clientes (reagendamientos, confirmaciones, etc.).
model UserNotification {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  metadata  Json?
  reminderKey String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt(sort: Desc)])
  @@unique([userId, reminderKey])
}

/// Suscripción Web Push (PWA) para avisos en el celular con la app cerrada.
model PushSubscription {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
